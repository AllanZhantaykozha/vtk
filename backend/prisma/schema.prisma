datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum NotificationStatus {
  LOW
  MEDIUM
  HIGH
}

enum TestSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  login     String   @unique
  password  String
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher       Teacher?       @relation("UserToTeacher")
  student       Student?       @relation("UserToStudent")
  admin         Admin?         @relation("UserToAdmin")
  notifications Notification[]

  @@index([login])
}

model Teacher {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation("UserToTeacher", fields: [userId], references: [id], onDelete: Cascade)

  subjects TeacherSubject[] @relation("TeacherSubjects")
  tests    Test[]           @relation("TeacherTests")
  lectures Lecture[]        @relation("TeacherLectures")
}

model Student {
  id          Int              @id @default(autoincrement())
  userId      Int              @unique
  groupId     Int? // Nullable to allow students without a group
  group       Group?           @relation("GroupStudents", fields: [groupId], references: [id], onDelete: SetNull)
  user        User             @relation("UserToStudent", fields: [userId], references: [id], onDelete: Cascade)
  submissions TestSubmission[] @relation("StudentSubmissions")
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation("UserToAdmin", fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique

  groups   GroupSubject[]   @relation("GroupSubjects")
  teachers TeacherSubject[] @relation("TeacherSubjects")
  tests    Test[]           @relation("TestSubject")
  lectures Lecture[]        @relation("LectureSubject")

  @@index([name])
}

model Group {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  subjects GroupSubject[] @relation("GroupSubjects")
  students Student[]      @relation("GroupStudents")

  @@index([name])
}

model GroupSubject {
  groupId   Int
  subjectId Int
  group     Group   @relation("GroupSubjects", fields: [groupId], references: [id], onDelete: Cascade)
  subject   Subject @relation("GroupSubjects", fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([groupId, subjectId])
  @@index([subjectId])
}

model TeacherSubject {
  teacherId Int
  subjectId Int
  teacher   Teacher @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation("TeacherSubjects", fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model Test {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  subjectId   Int
  subject     Subject          @relation("TestSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId   Int
  teacher     Teacher          @relation("TeacherTests", fields: [teacherId], references: [id], onDelete: Cascade)
  uploadDate  DateTime         @default(now())
  questions   Question[]       @relation("TestQuestions")
  submissions TestSubmission[] @relation("TestSubmissions")

  @@index([subjectId, teacherId])
}

model Question {
  id      Int      @id @default(autoincrement())
  testId  Int
  test    Test     @relation("TestQuestions", fields: [testId], references: [id], onDelete: Cascade)
  text    String
  image   String?
  type    String   @default("single")
  options Option[] @relation("QuestionOptions")
  correct Int[] // 

  @@index([testId])
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation("QuestionOptions", fields: [questionId], references: [id], onDelete: Cascade)
  text       String

  @@index([questionId])
}

model TestSubmission {
  id          Int                  @id @default(autoincrement())
  testId      Int
  test        Test                 @relation("TestSubmissions", fields: [testId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student              @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  answers     Json
  score       Int
  submittedAt DateTime             @default(now())
  status      TestSubmissionStatus @default(PENDING)

  @@index([testId, studentId])
}

model Lecture {
  id          Int      @id @default(autoincrement())
  title       String
  subjectId   Int
  subject     Subject  @relation("LectureSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId   Int
  teacher     Teacher  @relation("TeacherLectures", fields: [teacherId], references: [id], onDelete: Cascade)
  description String
  uploadDate  DateTime @default(now())
  fileContent Bytes

  @@index([subjectId, teacherId])
}

model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  status    NotificationStatus
  createdAt DateTime           @default(now())
  read      Boolean            @default(false)

  @@index([userId])
  @@index([status])
}
